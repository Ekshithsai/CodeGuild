# Frontend Environment Variables

# Backend API URL (change this to your deployed backend URL)
REACT_APP_BACKEND_URL=http://localhost:5000

# Judge0 API (optional - Piston API is used as default/free fallback)
# Get a key at: https://rapidapi.com/judge0-official/api/judge0-ce
# REACT_APP_JUDGE=https://judge0-ce.p.rapidapi.com/submissions?rapidapi-key=YOUR_KEY
